# Server Port (default: 16261)
PORT=16261

# Admin Dashboard Password (used to access /admin)
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Admin Secret Key (used to sign admin session tokens)
ADMIN_SECRET=change_this_to_a_random_admin_secret_string

# JWT Secret Key (used for signing access tokens)
JWT_SECRET=change_this_to_a_random_jwt_secret_string
